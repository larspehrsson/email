{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Email",
  "version": "0.1.0",
  "identifier": "dev.mailclient.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; frame-src 'self' about: data:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/email.desktop",
        "files": {
          "/usr/share/metainfo/dev.mailclient.desktop.metainfo.xml": "linux/dev.mailclient.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/email.desktop",
        "files": {
          "/usr/share/metainfo/dev.mailclient.desktop.metainfo.xml": "linux/dev.mailclient.desktop.metainfo.xml"
        }
      }
    },
    "shortDescription": "A fast, local-first email app",
    "longDescription": "All your accounts in one window (Gmail, Outlook and Microsoft 365, any IMAP server), your mail kept on your computer: conversations, search as you type, tags, snooze, undo send and a keyboard for everything.",
    "homepage": "https://github.com/rickhall/email",
    "category": "Productivity",
    "license": "MIT"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto"
        ]
      }
    }
  }
}
